WITH base_cte AS (
  SELECT
    CONCAT((SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id'),user_pseudo_id) AS session_id,
    event_name,
    session_traffic_source_last_click.manual_campaign.source AS source,
    session_traffic_source_last_click.manual_campaign.medium AS medium,
    session_traffic_source_last_click.manual_campaign.campaign_name AS campaign,
    session_traffic_source_last_click.manual_campaign.campaign_id as campaign_id,
    IFNULL(ecommerce.purchase_revenue,0) AS purchase_revenue,
    countif(event_name='purchase') AS purchase_count
  FROM `mrdipeshashah.analytics_343520795.events_20251118`
  GROUP BY 1,2,3,4,5,6,7
),

derivative_cte AS (
  SELECT
    source,
    medium,
    campaign,
    campaign_id,
    COUNT(DISTINCT session_id) AS sessions,
    COUNT(DISTINCT
      CASE WHEN session_id IN (
        SELECT session_id
        FROM base_cte
        WHERE event_name = 'add_to_cart')
      OR session_id IN (
          SELECT session_id
          FROM base_cte
          WHERE event_name = 'select_item'
        ) THEN session_id
      END) AS engagements,
    SUM(purchase_revenue) As purchase_revenue,
    SUM(purchase_count) AS purchase_count
  FROM base_cte
  GROUP BY 1,2,3,4
)

SELECT
  source,
  medium,
  campaign,
  campaign_id,
  SUM(sessions) AS total_sessions,
  SUM(engagements) AS total_engagements,
  SUM(sessions) - SUM(engagements) AS bounced_traffic,
  SUM(engagements) AS non_bounce_traffic,
  SUM(purchase_revenue) AS purchase_revenue,
  SUM(purchase_count) AS purchase_count
FROM derivative_cte
GROUP BY 1,2,3,4;

