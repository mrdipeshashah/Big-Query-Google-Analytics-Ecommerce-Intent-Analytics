WITH base_events AS (
  SELECT
    CONCAT(user_pseudo_id, '_', (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')) AS session_id,
    event_name,
    event_timestamp,
    
    COALESCE(
      REGEXP_EXTRACT(
        (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location'),
        r'https?://[^/]+([^?#]*)'
      ),
      '/'
    ) AS event_page_path,
    
    session_traffic_source_last_click.manual_campaign.source AS source,
    session_traffic_source_last_click.manual_campaign.medium AS medium,
    session_traffic_source_last_click.manual_campaign.campaign_name AS campaign,
    session_traffic_source_last_click.manual_campaign.campaign_id AS campaign_id,
    
    ecommerce.purchase_revenue
  FROM `mrdipeshashah.analytics_343520795.events_*`
  WHERE (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') IS NOT NULL
    AND _TABLE_SUFFIX BETWEEN '20260801' AND '20260816'
),

session_landing_pages AS (
  SELECT
    session_id,
    ARRAY_AGG(event_page_path ORDER BY event_timestamp ASC LIMIT 1)[SAFE_OFFSET(0)] AS landing_page
  FROM base_events
  GROUP BY 1
),

session_metrics AS (
  SELECT
    e.session_id,
    l.landing_page,
    
    ANY_VALUE(e.source) AS source,
    ANY_VALUE(e.medium) AS medium,
    ANY_VALUE(e.campaign) AS campaign,
    ANY_VALUE(e.campaign_id) AS campaign_id,
    
    LOGICAL_OR(e.event_name = 'select_item' AND e.event_page_path = l.landing_page) AS had_select_item_on_landing,
    LOGICAL_OR(e.event_name IN ('add_to_cart', 'add_to_wishlist') AND e.event_page_path = l.landing_page) AS had_pdp_action_on_landing,
    LOGICAL_OR(e.event_name IN ('begin_checkout', 'purchase') AND e.event_page_path = l.landing_page) AS had_checkout_action_on_landing,
    
    LOGICAL_OR(e.event_name IN ('select_item', 'add_to_cart', 'add_to_wishlist', 'begin_checkout') AND e.event_page_path = l.landing_page) AS is_page_engaged,
    
    COUNTIF(e.event_name = 'purchase') AS purchases,
    SUM(IF(e.event_name = 'purchase', e.purchase_revenue, 0)) AS revenue

  FROM base_events e
  JOIN session_landing_pages l ON e.session_id = l.session_id
  GROUP BY 1, 2
),

page_classified_sessions AS (
  SELECT
    session_id,
    landing_page,
    source,
    medium,
    campaign,
    campaign_id,
    is_page_engaged,
    purchases,
    revenue,
    
    CASE 
      WHEN landing_page LIKE '%/product/%' OR had_pdp_action_on_landing THEN 'PDP (Product Page)'
      WHEN landing_page LIKE '%/shop%' OR landing_page LIKE '%/category/%' OR had_select_item_on_landing THEN 'PLP (Listing Page)'
      WHEN landing_page LIKE '%/checkout%' OR landing_page LIKE '%/cart%' OR had_checkout_action_on_landing THEN 'Checkout / Cart'
      WHEN landing_page = '/' THEN 'Homepage'
      ELSE 'Other / Info Page'
    END AS page_type
  FROM session_metrics
)

SELECT
  page_type,
  landing_page,
  COALESCE(source, '(direct)') AS source,
  COALESCE(medium, '(none)') AS medium,
  COALESCE(campaign, '(not set)') AS campaign,
  campaign_id,
  
  -- Raw Counts Only
  COUNT(DISTINCT session_id) AS total_sessions,
  COUNT(DISTINCT CASE WHEN is_page_engaged THEN session_id END) AS engaged_sessions,
  COUNT(DISTINCT CASE WHEN NOT is_page_engaged OR is_page_engaged IS NULL THEN session_id END) AS bounced_sessions,
  
  SUM(purchases) AS total_purchases,
  SUM(revenue) AS total_revenue

FROM page_classified_sessions
GROUP BY 1, 2, 3, 4, 5, 6;
